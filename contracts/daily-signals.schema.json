{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily ai Radar snapshot",
  "description": "Contrato v1. Impacto y acción son juicios editoriales; unknown/null indican datos no verificados.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "domain",
    "snapshotDate",
    "timezone",
    "savedAt",
    "language",
    "collection",
    "signals"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "project": {
      "const": "AI Radar"
    },
    "domain": {
      "const": "ai"
    },
    "snapshotDate": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "const": "America/Matamoros"
    },
    "savedAt": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "const": "es"
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "scope",
        "queries",
        "limitations"
      ],
      "properties": {
        "mode": {
          "const": "manual-assisted"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "topic",
          "publishedDate",
          "studyPublishedDate",
          "eventGroupId",
          "sources",
          "evidence",
          "impact",
          "action",
          "state",
          "biomedical"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AI-[0-9]{2,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "publishedDate": {
            "type": "string",
            "format": "date"
          },
          "studyPublishedDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "eventGroupId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "publisher",
                "url",
                "sourceType",
                "accessedAt"
              ],
              "properties": {
                "publisher": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "sourceType": {
                  "enum": [
                    "secondary",
                    "primary-institutional"
                  ]
                },
                "accessedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "summary",
              "limitations",
              "reviewScope"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "limitations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reviewScope": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "impact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "rationale",
              "assessmentType"
            ],
            "properties": {
              "level": {
                "enum": [
                  "alto",
                  "medio",
                  "bajo",
                  "desconocido"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "assessmentType": {
                "const": "editorial"
              }
            }
          },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "status"
            ],
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "proposed",
                  "in-progress",
                  "completed"
                ]
              }
            }
          },
          "state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "detail"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "biomedical": {
            "type": "null"
          }
        }
      }
    }
  }
}
